<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Cupscale</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>     <!-- Legacy designer properties -->
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationIcon>CupscaleLogo1.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <!-- dotnet publish: one self-contained exe, no .NET install needed -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- .NET Framework-only WinForms controls; they run on .NET 10 -->
    <PackageReference Include="CyotekImageBox" Version="1.2.1" NoWarn="NU1701" />
    <PackageReference Include="CyotekTabList" Version="2.0.0" NoWarn="NU1701" />
    <PackageReference Include="DdsFileTypePlusHack" Version="1.2.1" />
    <PackageReference Include="HTAlt.WinForms" Version="0.1.6" NoWarn="NU1701" />     <!-- 0.1.7 no longer derives HTButton from Button -->
    <PackageReference Include="Win32Interop.Dwmapi" Version="1.0.1" NoWarn="NU1701" />
    <PackageReference Include="Win32Interop.Gdi32" Version="1.0.1" NoWarn="NU1701" />
    <PackageReference Include="Win32Interop.Kernel32" Version="1.0.1" NoWarn="NU1701" />
    <PackageReference Include="Win32Interop.User32" Version="1.0.1" NoWarn="NU1701" />
    <PackageReference Include="Win32Interop.Uxtheme" Version="1.0.1" NoWarn="NU1701" />
    <PackageReference Include="Magick.NET-Q16-x64" Version="14.17.1" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="MozJpegSharp" Version="1.0.27" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <PackageReference Include="System.Management" Version="10.0.12" />  </ItemGroup>
  <ItemGroup>
    <Compile Update="Main\MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Main\MainForm.resx">
      <Generator></Generator>
      <CustomToolNamespace></CustomToolNamespace>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\compare.html" LogicalName="compare.html" />
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <!-- BuildInfo.Version = contents of ..\VERSION, baked in at compile time -->
  <PropertyGroup>
    <AppVersion>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\VERSION').Trim())</AppVersion>
  </PropertyGroup>
  <ItemGroup>
    <UpToDateCheckInput Include="..\VERSION" />
  </ItemGroup>
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile" Inputs="..\VERSION" Outputs="$(IntermediateOutputPath)BuildInfo.g.cs">
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="namespace Cupscale { static class BuildInfo { public const string Version = &quot;$(AppVersion)&quot;%3B } }" />
  </Target>
  <Target Name="IncludeBuildInfo" BeforeTargets="CoreCompile" AfterTargets="GenerateBuildInfo">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
</Project>
